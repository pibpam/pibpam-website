{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pibpam-web",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "pibpam-prod",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["start"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "pibpam-web-behind-site",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "ASSET_PREFIX=http://localhost:3000 yarn dev"],
      "port": 3000
    },
    {
      "name": "pibpam-site",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd site && PATH=$HOME/.nvm/versions/node/v22.13.0/bin:$PATH yarn dev -p ${PORT:-3001}"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "pibpam-storybook",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["storybook"],
      "port": 6006,
      "autoPort": true
    }
  ]
}
