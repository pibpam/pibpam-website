# URL base do backend upstream (só usada no servidor)
API=https://api.pibpam.org/
# URL pública canônica do site (SEO: canonical, sitemap, OG)
SITE_URL=https://www.pibpam.org
# App legado (app.pibpam.org). Obrigatório em produção (o deploy falha sem ele):
# o app nativo antigo ainda abre pibpam.org e depende do proxy. Vazio em dev.
LEGACY_APP_URL=
# Liga o envio do formulário de contato para POST {API}/v1/contact-messages
CONTACT_ENABLED=false
